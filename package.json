{
  "name": "@telegram-standard-bot-api/mono-repo",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "scripts": {
    "lint": "eslint . --cache && prettier --check '**/*.{js,ts,md,json,yml}' && pnpm -r run build:no-emit",
    "lint:fix": "eslint . --cache --fix && prettier --write '**/*.{js,ts,md,json,yml}'",
    "test": "vitest --run",
    "prebuild": "pnpm --filter @telegram-standard-bot-api/shared build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
