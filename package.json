{
  "name": "@telegram-standard-bot-api/mono-repo",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache && prettier --cache --check '**/*.{js,ts,md,json,yml}' && knip && pnpm build",
    "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --fix && prettier --write '**/*.{js,ts,md,json,yml}'",
    "test": "vitest --run",
    "build": "tsc -b tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "jiti": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
