{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "declaration": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "composite": true
  },
  "include": ["./src"],
  "exclude": ["node_modules", "dist"]
}
