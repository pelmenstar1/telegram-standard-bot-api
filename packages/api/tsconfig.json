{
  "compilerOptions": {
    "target": "es2018",
    "module": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "moduleResolution": "node16",
    "declaration": true,
    "skipLibCheck": true,
    "strict": true,
    "composite": true
  },
  "include": ["./src"],
  "exclude": ["node_modules", "dist"]
}
